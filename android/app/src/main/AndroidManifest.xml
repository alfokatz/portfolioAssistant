<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Notificaciones push (Android 13+ pide permiso en tiempo de ejecución). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Porty"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Canal para los mensajes de FCM que no traen uno (los canales los
             crea la app: ver push_messaging.dart). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="account" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Los deep links de auth los procesa supabase_flutter (app_links),
                 no el router: sin esto Flutter le pasaría porty://…?code= a
                 GoRouter como si fuera una ruta. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Links de los emails de Supabase (confirmar cuenta y restablecer
                 contraseña): porty://login-callback y porty://reset-password.
                 Los procesa supabase_flutter (app_links). Ver
                 lib/config/supabase/supabase_redirect_url.dart. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="porty" android:host="login-callback" />
                <data android:scheme="porty" android:host="reset-password" />
            </intent-filter>
        </activity>
        <!-- Vueltas de flutter_web_auth_2 (Auth Tab / Custom Tabs):
             - eToro: la edge function etoro-sync redirige a porty-etoro://callback.
             - Login con Google / Apple (OAuth PKCE de Supabase): porty-oauth://callback.
             Esquemas propios, distintos del de los emails (porty://), para que
             el code de OAuth no lo consuma otro handler de deep links. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="porty-etoro" />
                <data android:scheme="porty-oauth" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
