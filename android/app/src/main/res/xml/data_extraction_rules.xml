<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ni la nube ni la transferencia entre dispositivos llevan el
     resumen de cartera del widget. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
