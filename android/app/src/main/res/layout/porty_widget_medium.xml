<?xml version="1.0" encoding="utf-8"?>
<!-- Mediano 4x2: izquierda cara + % + gráfico; derecha una novedad con "siguiente" y una pregunta.
     Las vistas previas (_preview) llevan datos ficticios, nunca la cartera real. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/porty_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_value_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="yes"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_face"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/porty_widget_avatar" />

                <TextView
                    android:id="@+id/widget_period"
                    style="@style/PortyWidget.Period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_pct"
                style="@style/PortyWidget.Total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textSize="30sp" />

            <ImageView
                android:id="@+id/widget_chart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_updated"
                style="@style/PortyWidget.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/widget_item_head"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_item_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_news" />

                        <TextView
                            android:id="@+id/widget_tag"
                            style="@style/PortyWidget.Tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/porty_widget_tag"
                            android:importantForAccessibility="no"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/widget_item_meta"
                            style="@style/PortyWidget.Meta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_item_text"
                        style="@style/PortyWidget.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="2" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_hidden_text"
                    style="@style/PortyWidget.Item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/porty_widget_chip"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_next"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_q1"
                style="@style/PortyWidget.Question"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/porty_widget_question_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/porty_widget_avatar" />

        <TextView
            android:id="@+id/widget_empty_text"
            style="@style/PortyWidget.Message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no"
            android:maxLines="4"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
