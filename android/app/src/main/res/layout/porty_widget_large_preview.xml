<?xml version="1.0" encoding="utf-8"?>
<!-- Grande 4x4: encabezado + % + gráfico + 3 filas fijas (las sobrantes GONE, sin ListView) + 2 preguntas.
     Las vistas previas (_preview) llevan datos ficticios, nunca la cartera real. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/porty_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:orientation="vertical"
        android:contentDescription="@string/widget_sample_a11y">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/porty_widget_avatar" />

                <TextView
                    style="@style/PortyWidget.Message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
        android:text="@string/widget_sample_header"/>

                <TextView
                    style="@style/PortyWidget.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
        android:text="@string/widget_sample_age"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/PortyWidget.Total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="28sp"
        android:text="@string/widget_sample_pct"
        android:textColor="@color/porty_widget_profit"/>

                <TextView
                    style="@style/PortyWidget.Period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
        android:text="@string/widget_sample_period"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
        android:src="@drawable/porty_widget_chart_preview"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/PortyWidget.Period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no"
            android:maxLines="1"
        android:text="@string/widget_sample_list_title"/>

        <TextView
            style="@style/PortyWidget.Item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_calendar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PortyWidget.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/porty_widget_tag"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
        android:text="ACME"/>

                    <TextView
                        style="@style/PortyWidget.Item"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
        android:text="@string/widget_sample_item_earnings"/>
                </LinearLayout>

                <TextView
                    style="@style/PortyWidget.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
        android:text="@string/widget_sample_meta_earnings"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_news" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PortyWidget.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/porty_widget_tag"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
        android:text="ZYNT"/>

                    <TextView
                        style="@style/PortyWidget.Item"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
        android:text="@string/widget_sample_item_news_2"/>
                </LinearLayout>

                <TextView
                    style="@style/PortyWidget.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
        android:text="@string/widget_sample_meta_news"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_pie" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PortyWidget.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/porty_widget_tag"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
        android:visibility="gone"/>

                    <TextView
                        style="@style/PortyWidget.Item"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
        android:text="@string/widget_sample_item_insight"/>
                </LinearLayout>

                <TextView
                    style="@style/PortyWidget.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
        android:text="@string/widget_sample_meta_insight"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/PortyWidget.Question"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/porty_widget_question_chip"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
        android:text="@string/widget_sample_q_earnings"/>

        <TextView
            style="@style/PortyWidget.Question"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/porty_widget_question_chip"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
        android:text="@string/widget_sample_q_goal"/>
    </LinearLayout>

</FrameLayout>
