<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x4: encabezado + frase + novedades (hasta 4 filas fijas, sin ListView) + 2 preguntas.
     Las vistas previas (_preview) llevan datos ficticios, nunca la cartera real. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/porty_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_value_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes" android:contentDescription="@string/widget_sample_a11y"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/porty_widget_avatar" />

                <TextView
                    android:id="@+id/widget_period"
                    style="@style/PortyWidget.Period"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:maxLines="1" android:text="@string/widget_sample_period" />

                <TextView
                    android:id="@+id/widget_updated"
                    style="@style/PortyWidget.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1" android:text="@string/widget_sample_updated" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_total"
                    style="@style/PortyWidget.Total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:maxLines="1" android:text="$10,000.00" />

                <TextView
                    android:id="@+id/widget_change"
                    style="@style/PortyWidget.Change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1" android:textColor="@color/porty_widget_profit" android:text="+$50.00" />

                <TextView
                    android:id="@+id/widget_pct"
                    style="@style/PortyWidget.Change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1" android:textColor="@color/porty_widget_profit" android:text="+0.5%" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_phrase"
            style="@style/PortyWidget.Phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1" android:text="@string/widget_sample_phrase" />

        <LinearLayout
            android:id="@+id/widget_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_section_title"
                style="@style/PortyWidget.Period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:maxLines="1" android:text="@string/widget_sample_items_section" />

            <TextView
                android:id="@+id/widget_section_empty"
                style="@style/PortyWidget.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="3"
                android:textSize="12sp"
                android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_item_1_meta"
                style="@style/PortyWidget.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_item_1_text"
                style="@style/PortyWidget.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:text="@string/widget_sample_item_earnings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="5dp"
                android:background="@color/porty_widget_hairline"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_item_2_meta"
                style="@style/PortyWidget.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_sample_item_meta_1" />

            <TextView
                android:id="@+id/widget_item_2_text"
                style="@style/PortyWidget.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:text="@string/widget_sample_item_news_1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="5dp"
                android:background="@color/porty_widget_hairline"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_item_3_meta"
                style="@style/PortyWidget.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_sample_item_meta_2" />

            <TextView
                android:id="@+id/widget_item_3_text"
                style="@style/PortyWidget.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:text="@string/widget_sample_item_news_2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="5dp"
                android:background="@color/porty_widget_hairline"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/widget_item_4_meta"
                style="@style/PortyWidget.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_item_4_text"
                style="@style/PortyWidget.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="2" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_q_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_q1"
                style="@style/PortyWidget.Question"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:background="@drawable/porty_widget_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/widget_sample_q_today" />

            <TextView
                android:id="@+id/widget_q2"
                style="@style/PortyWidget.Question"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/porty_widget_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/widget_sample_q_top_mover" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_q_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_qb1"
                style="@style/PortyWidget.Question"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/porty_widget_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/widget_qb2"
                style="@style/PortyWidget.Question"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/porty_widget_chip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
